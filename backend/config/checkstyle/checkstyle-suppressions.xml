<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!-- ADR 0005: Javadoc is written where it carries a reason or a contract, not on every member. -->
<suppressions>
  <suppress checks="MissingJavadocMethod|MissingJavadocType" files=".*"/>
</suppressions>
