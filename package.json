{
  "name": "alliedpayroll",
  "private": true,
  "description": "Allied Payroll monorepo: Spring Boot backend, React web, Flutter mobile, design tokens",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "lefthook install && pnpm api:build",
    "tokens:build": "pnpm --filter @alliedpayroll/design-tokens build",
    "web": "pnpm --filter @alliedpayroll/web",
    "check": "pnpm -r --if-present run check",
    "api:generate": "pnpm --filter @alliedpayroll/api-client generate && pnpm --filter @alliedpayroll/api-client build",
    "api:build": "pnpm --filter @alliedpayroll/api-client build"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2"
  }
}
